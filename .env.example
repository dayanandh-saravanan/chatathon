# Supabase — required for persistence. Without these the app runs on the
# in-memory repository, which is fully functional but resets on restart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Model — both optional, tried in this order: Gemini, then Anthropic, then the
# deterministic planner. The planner produces the same structured output with
# fixed copy, so a missing key costs wording and nothing else.
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
# Optional override if the Anthropic model name moves. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# ElevenLabs — optional. Without it the agent has no speaking voice and the
# speak endpoint reports { available: false } rather than failing.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
